                    transition: 'width 0.6s cubic-bezier(0.22,1,0.36,1)',
                    boxShadow: '0 0 8px rgba(212,166,87,0.4)',
                  }}
                />
              </div>
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  fontSize: 11,
                  color: '#6a7388',
                }}
