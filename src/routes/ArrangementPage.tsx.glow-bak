            border: '1px solid var(--ink-border)',
            borderRadius: 16,
            overflow: 'hidden',
            boxShadow: '0 4px 24px rgba(0,0,0,0.3)',
            marginBottom: 20,
          }}
        >
          <div
            style={{
              padding: '20px 24px',
              borderBottom: '1px solid var(--ink-border)',
            }}
          >
            <h2
              style={{
                fontSize: 17,
                fontWeight: 700,
                color: '#e8e4d8',
              }}
            >
              章节配置与生成
            </h2>
          </div>

          <div style={{ padding: '24px' }}>
            {/* 风格 & 基调 */}
            <div
