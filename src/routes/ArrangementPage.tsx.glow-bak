                    e.currentTarget.style.borderColor = 'rgba(212,166,87,0.4)';
                    e.currentTarget.style.boxShadow = '0 0 0 3px rgba(212,166,87,0.08)';
                  }}
                  onBlur={(e) => {
                    e.currentTarget.style.borderColor = 'var(--ink-border)';
                    e.currentTarget.style.boxShadow = 'none';
                  }}
