                  disabled={false}
                  style={{
                    ...goldBtn,
                    padding: '10px 20px',
                  }}
                  onMouseEnter={(e) => {
                    e.currentTarget.style.transform = 'scale(1.02)';
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.transform = 'scale(1)';
                  }}
                >
                  {'\u2726'} 立即生成大纲
                </button>
              </div>
            </div>

            {/* 批量管理与任务 */}
            <div
              style={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'space-between',
                marginBottom: 16,
