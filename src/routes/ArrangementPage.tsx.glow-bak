                    border: '1px solid var(--ink-border)',
                    borderRadius: 8,
                    fontSize: 13,
                    lineHeight: 1.6,
                    color: '#e8e4d8',
                    background: 'var(--ink-deep)',
                    resize: 'vertical',
                    outline: 'none',
                    fontFamily: '"Noto Sans SC", sans-serif',
                    transition: 'border-color 0.2s, box-shadow 0.2s',
                  }}
