                <span>初始 (0%)</span>
                <span style={{ color: '#f0c674' }}>{'\u25BC'} 当前底线 ({progress}%)</span>
                <span>完结 (100%)</span>
              </div>
            </div>

            {/* 生成控制 */}
            <div
