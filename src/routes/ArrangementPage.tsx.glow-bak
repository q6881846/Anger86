                    borderRadius: 8,
                    background: batchMode ? 'rgba(212,166,87,0.1)' : 'var(--ink-surface)',
                    color: batchMode ? '#f0c674' : '#8a93a8',
                    fontSize: 13,
                    fontWeight: 600,
                    cursor: 'pointer',
                    transition: 'all 0.2s',
                  }}
                >
