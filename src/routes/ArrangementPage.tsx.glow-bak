                background: 'var(--ink-surface)',
                border: '1px solid var(--ink-border)',
                borderRadius: 12,
                padding: '20px 24px',
                marginBottom: 24,
              }}
            >
              <div
                style={{
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  marginBottom: 12,
                }}
              >
                <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
                  <span style={{ fontSize: 14, fontWeight: 600, color: '#8a93a8' }}>
                    {'\u2699'} 剧情推进进度
                  </span>
                </div>
                <span
                  style={{
                    fontSize: 20,
                    fontWeight: 700,
                    color: '#f0c674',
