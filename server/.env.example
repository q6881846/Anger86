# ============================================
# Prompt Service 环境变量配置
# ============================================
# 使用方法：复制本文件为 .env 并填入实际值
#   cp .env.example .env
#
# .env 文件不应提交到版本控制（已在 .gitignore 中忽略）

# LLM API 密钥（必填）
# 安全警告：此密钥仅存于后端 .env，绝不可通过 VITE_ 前缀暴露到前端 bundle
LLM_API_KEY=your-key-here

# LLM 供应商类型（openai / anthropic / google / gemini / custom）
# custom 需自行在 llm-adapter.js 中实现适配
LLM_PROVIDER=openai

# LLM API 基础地址（默认 https://api.openai.com/v1）
LLM_BASE_URL=https://api.openai.com/v1

# LLM 模型名称（默认 gpt-4o-mini）
LLM_MODEL=gpt-4o-mini

# Prompt Service 端口（默认 3456）
PROMPT_PORT=3456

# Prompt Service 访问密钥（前端/外部调用时必须携带 Header X-API-Key）
# 未配置时仅允许本机访问；生产环境务必修改默认值！
PROMPT_SERVICE_KEY=change-me-in-production
